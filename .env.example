# Скопируйте в .env:  cp .env.example .env   и отредактируйте:  nano .env

# --- Админ-панель (первый запуск создаёт этого админа). ОБЯЗАТЕЛЬНО смените пароль!
ADMIN_USER=admin
ADMIN_PASS=ChangeMe_12345

# --- Сайт
PORT=8000
# Адрес сайта, который бот показывает пользователям (необязательно)
SITE_URL=

# --- Telegram-бот (токен выдаёт @BotFather). Без токена работает только сайт.
BOT_TOKEN=
BOT_USERNAME=
# Telegram ID админов (через запятую) — получают уведомления о заявках на пополнение. Свой ID: бот @userinfobot
ADMIN_TG_IDS=

# --- Zoom (необязательно). Без этого просто вставляйте ссылки на Zoom-встречи вручную.
# Zoom Marketplace -> Develop -> Build App -> Server-to-Server OAuth (scope: meeting:write:meeting:admin)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
TZ_NAME=Asia/Tashkent
